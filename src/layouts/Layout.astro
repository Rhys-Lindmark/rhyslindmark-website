---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	wide?: boolean;
	fit?: boolean;
}

const { title, description = 'Rhys Lindmark', canonical, wide = false, fit = false } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title === 'Rhys Lindmark' ? title : `${title} — Rhys Lindmark`}</title>
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-H8JQL37YCD"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() { dataLayer.push(arguments); }
			gtag('js', new Date());
			gtag('config', 'G-H8JQL37YCD');
		</script>
	</head>
	<body class={fit ? 'fit' : undefined}>
		<main class={[wide && 'wide', fit && 'fit'].filter(Boolean).join(' ') || undefined}>
			<slot />
		</main>
	</body>
</html>
