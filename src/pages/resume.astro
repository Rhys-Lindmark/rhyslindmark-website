---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { marked } from 'marked';
import Layout from '../layouts/Layout.astro';

// Renders straight from resume.md at the project root —
// edit that file and refresh, no manual transcription needed.
const mdPath = resolve(process.cwd(), 'resume.md');
const raw = readFileSync(mdPath, 'utf-8').trim();
// A role heading reads "Org — Location · Dates"; split it so each part can be styled.
// The name and the contact line after it are wrapped so they can share a row.
// Each "## Section" and what follows it becomes <section data-section="slug">, so a whole section can be styled.
const html = (marked.parse(raw) as string)
	.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>([\s\S]*?)(?=<h2|$)/g, (_, attrs, title, body) => {
		const slug = title.replace(/<[^>]+>/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
		return `<section data-section="${slug}"><h2${attrs}>${title}</h2>${body}</section>`;
	})
	// Keep each fact/skill intact, with extra separators where print line breaks hide.
	.replace(/(<section data-section="other">[\s\S]*?)(?=<blockquote>)/, (_, blocks) =>
		blocks.replace(/<p>([\s\S]*?)<\/p>/g, (_, body) => `<p>${body
			.split(/<br\s*\/?>/)
			.map((line, lineIndex, lines) => line.trim().split(' · ').map((item, itemIndex, items) => {
				const separator = itemIndex < items.length - 1 ? ' ·' : lineIndex < lines.length - 1
					? '<span class="screen-separator" aria-hidden="true"> ·</span>' : '';
				return `<span class="other-item">${item}${separator}</span>`;
			}).join(' '))
			.join('<br>\n')}</p>`),
	)
	.replace(/<h3([^>]*)>(.*) · ([^<]+)<\/h3>/g, (_, attrs, place, dates) => {
		const [org, loc = ''] = place.split(' — ');
		return `<h3${attrs}><span class="org">${org}</span><span class="loc">${loc}</span><span class="dates">${dates}</span></h3>`;
	})
	.replace(
		/(<h1[^>]*>[\s\S]*?<\/h1>)(\s*<p>[\s\S]*?<\/p>)/,
		'<header>$1<img class="mark" src="/resume-mark.png" alt="">$2</header>',
	);
---

<Layout title="Resume" description="Rhys Lindmark's resume: founder, chief of staff and ecosystem lead.">
	<p class="resume-pdf"><a href="/resume.pdf">PDF</a></p>
	<div class="resume" set:html={html} />
</Layout>

<style>
	:global(main:has(.resume)) {
		max-width: 46rem;
	}

	.resume-pdf {
		font-family: var(--font-sans);
		font-size: .85rem;
		text-align: right;
		margin: 0;
	}

	.resume :global(h1) {
		font-size: 2rem;
		margin: 0 0 .25rem;
	}

	/* Name and swoosh share the first row; the contact line wraps below. */
	.resume :global(header) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
	}

	.resume :global(header .mark) {
		height: 2.25rem;
		margin-left: .75rem;
	}

	.resume :global(header p) {
		flex-basis: 100%;
		font-family: var(--font-sans);
		font-size: .9rem;
		color: var(--muted);
	}

	.resume :global(h2) {
		display: flex;
		align-items: center;
		gap: .75rem;
		font-family: var(--font-sans);
		font-size: .75rem;
		font-weight: 600;
		letter-spacing: .12em;
		text-transform: uppercase;
		margin: 2.5rem 0 1rem;
	}

	.resume :global(h2::after) {
		content: '';
		flex: 1;
		border-top: 1px solid var(--rule);
	}

	.resume :global(h3) {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		font-size: 1.1rem;
		margin: 1.75rem 0 .1rem;
	}

	.resume :global(h3 .org) {
		font-weight: 600;
	}

	.resume :global(h3 .loc) {
		margin-left: .5em;
		color: var(--muted);
		font-size: .9em;
	}

	.resume :global(h3 .dates) {
		margin-left: auto;
		padding-left: 1rem;
		font-size: .9em;
		font-variant-numeric: tabular-nums;
		color: var(--muted);
		white-space: nowrap;
	}

	.resume :global(h3 + p) {
		margin-bottom: .5rem;
	}

	.resume :global(li),
	.resume :global(p) {
		text-wrap: pretty;
	}

	.resume :global(li) {
		margin-bottom: .3rem;
	}

	.resume :global(li::marker) {
		color: var(--muted);
	}

	/* Stable columns keep the two blocks aligned even when their text wraps. */
	.resume :global([data-section='other']) {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		align-items: start;
		gap: .75rem 1.5rem;
	}

	.resume :global([data-section='other'] > h2),
	.resume :global([data-section='other'] > blockquote) {
		grid-column: 1 / -1;
	}

	.resume :global([data-section='other'] > h2) {
		margin-bottom: 0;
	}

	.resume :global([data-section='other'] > p:last-of-type) {
		text-align: right;
	}

	.resume :global([data-section='other'] > p) {
		min-width: 0;
		margin: 0;
		font-family: var(--font-sans);
		font-size: .75rem;
		color: var(--muted);
	}

	.resume :global(blockquote) {
		border: 0;
		padding: 0;
		text-align: center;
		font-style: italic;
	}

	.resume :global([data-section='other'] blockquote) {
		margin: 0;
		font-size: .75rem;
		color: var(--muted);
	}

	.resume :global([data-section='other'] blockquote p) {
		margin: 0;
	}

	.resume :global(.screen-separator) {
		display: none;
	}

	@media screen {
		.resume :global(.other-item) {
			display: inline-block;
			white-space: nowrap;
		}

		.resume :global(.screen-separator) {
			display: inline;
		}

		/* Let screen text wrap naturally; retain the compact print line breaks. */
		.resume :global([data-section='other'] > p br) {
			display: none;
		}
	}

	@media screen and (max-width: 600px) {
		.resume :global([data-section='other']) {
			grid-template-columns: minmax(0, 1fr);
		}

		.resume :global([data-section='other'] > p:last-of-type) {
			text-align: left;
		}
	}

	.resume :global(a) {
		text-decoration-color: #aaa;
		text-decoration-thickness: 1px;
	}

	.resume :global(a:hover) {
		text-decoration-color: currentColor;
	}

	/* Zero page margins leave Chrome no room for its date/URL header and footer;
	   main's padding supplies the margin instead. */
	@page {
		size: letter;
		margin: 0;
	}

	@media print {
		:global(body) {
			font-size: 9pt;
			line-height: 1.28;
		}

		:global(main:has(.resume)) {
			max-width: none;
			padding: .28in .58in 0;
		}

		.resume-pdf {
			display: none;
		}

		.resume :global(header) {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			border-bottom: 1.5px solid var(--text);
			padding-bottom: .4rem;
			margin-bottom: .75rem;
		}

		.resume :global(h1) {
			font-size: 19.5pt;
			margin: 0;
		}

		.resume :global(header p) {
			flex-basis: auto;
			font-size: 8.5pt;
			margin: 0;
		}

		.resume :global(header .mark) {
			align-self: center;
			height: 22pt;
			margin: 0 auto;
		}

		/* The intro lines between the header and the first section. */
		.resume > :global(p) {
			font-size: 8.8pt;
			margin-bottom: .6rem;
		}

		.resume :global(header + p) {
			font-size: 9.8pt;
			margin-bottom: .55rem;
		}

		.resume :global(h2) {
			font-size: 7.5pt;
			margin: .75rem 0 .1rem;
		}

		/* Extra air between the intro and Work Experience. */
		.resume > :global(section:first-of-type > h2) {
			margin-top: 1.2rem;
		}

		.resume :global(h3) {
			font-size: 10.4pt;
			margin: .45rem 0 .05rem;
			break-after: avoid;
		}

		.resume :global(p) {
			margin-bottom: .35rem;
		}

		.resume :global(h3 + p) {
			margin-bottom: .1rem;
		}

		.resume :global(ul) {
			margin: 0;
			padding-left: 1.1rem;
		}

		.resume :global(li) {
			margin-bottom: 0;
		}

		.resume :global([data-section='other']) {
			row-gap: .1rem;
			break-inside: avoid;
		}

		.resume :global([data-section='other'] > p) {
			font-size: 7.6pt;
			margin-bottom: .2rem;
		}

		.resume :global([data-section='other'] blockquote) {
			margin: .15rem 0;
			font-size: 7.6pt;
		}

		.resume :global(h3 .org a) {
			text-decoration: none;
		}

		/* Keep links visible in the PDF without the screen's heavier underline. */
		.resume :global(a) {
			text-decoration-color: #c4c4c4;
			text-underline-offset: 2px;
		}
	}
</style>
