---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Tools" canonical="https://ai.rhyslindmark.com/tools">
  <main>
    <h1>Tools</h1>
    <p>Small tools to make things easier.</p>
    <section>
      <a href="/tools/lean-coffee"><h2>Lean Coffee →</h2><p>A shared discussion board for your next meeting. Add topics, vote together, and keep the conversation moving with a timer.</p></a>
      <a href="/tools/sf-hosting"><h2>SF hosting guide →</h2><p>Find places to gather and host a group in San Francisco.</p></a>
    </section>
  </main>
</Layout>
<style>
main{max-width:860px;margin:0 auto;padding:3rem 0 5rem}h1{font-size:2.5rem;margin:0 0 1rem}section{display:grid;gap:1rem;margin-top:2rem}a{display:block;color:var(--text);text-decoration:none;border:1px solid #aaa5;border-radius:12px;padding:1.4rem}a:hover{background:#8881}a:focus-visible{outline:3px solid currentColor;outline-offset:3px}h2{font-size:1.3rem;margin:0 0 .6rem}p{line-height:1.6;margin:0}
</style>
