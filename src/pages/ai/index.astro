---
import Layout from '../../layouts/Layout.astro';

const projects = [
	{
		path: 'https://ai.rhyslindmark.com/domestication',
		displayPath: '/domestication',
		label: 'How Everything Evolved',
		title: 'Visualizing Reality',
		description:
			'A source-traceable atlas of how humans have lived—and how domestication changed what societies could coordinate.',
	},
	{
		path: 'https://ai.rhyslindmark.com/donate',
		displayPath: '/donate',
		label: 'Market for Impact',
		title: 'Where should the next dollar go?',
		description:
			'A source-grounded market of philanthropic opportunities, evidence, funding room, and expected impact.',
	},
];
---

	<Layout
	title="Current AI Projects"
	description="AI projects being actively built by Rhys Lindmark and his background agents."
	canonical="https://ai.rhyslindmark.com/"
>
	<section class="ai-projects">
		<a class="back-link" href="https://www.rhyslindmark.com/">← Rhys Lindmark</a>
		<p class="eyebrow">Agents at work</p>
		<h1>Current AI projects</h1>
		<p class="intro">
			Experiments I’m building with AI agents in the background—researching, mapping, and turning big questions into useful public tools.
		</p>

		<div class="project-list">
			{projects.map((project) => (
				<a class="project" href={project.path}>
					<span class="project-label">{project.label}</span>
					<h2>{project.title}</h2>
					<p>{project.description}</p>
					<span class="project-path">ai.rhyslindmark.com{project.displayPath} <span aria-hidden="true">↗</span></span>
				</a>
			))}
		</div>
	</section>
</Layout>

<style>
	.ai-projects {
		padding: 1rem 0;
	}

	.back-link,
	.eyebrow,
	.project-label,
	.project-path {
		font-family: var(--font-sans);
	}

	.back-link {
		display: inline-block;
		margin-bottom: 4rem;
		color: var(--muted);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--text);
	}

	.eyebrow {
		margin: 0 0 0.6rem;
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 8vw, 4.75rem);
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 34rem;
		margin: 1.5rem 0 3.5rem;
		color: var(--muted);
		font-size: 1.2rem;
	}

	.project-list {
		border-top: 1px solid var(--rule);
	}

	.project {
		display: block;
		padding: 2rem 0;
		border-bottom: 1px solid var(--rule);
		color: var(--text);
		text-decoration: none;
		transition: padding 160ms ease;
	}

	.project:hover {
		padding-left: 0.5rem;
	}

	.project-label,
	.project-path {
		color: var(--muted);
		font-size: 0.82rem;
	}

	.project h2 {
		margin: 0.35rem 0 0.65rem;
		font-size: 1.65rem;
	}

	.project p {
		max-width: 34rem;
		margin-bottom: 1rem;
	}

	.project-path {
		text-decoration: underline;
		text-decoration-color: var(--rule);
		text-underline-offset: 3px;
	}
</style>
