---
import Layout from '../../layouts/Layout.astro';

const projects = [
	{
		url: 'https://ai.rhyslindmark.com/domestication',
		github: 'https://github.com/Rhys-Lindmark/visualizing-reality',
	},
	{
		url: 'https://ai.rhyslindmark.com/donate',
		github: 'https://github.com/Rhys-Lindmark/market-for-impact',
	},
];
---

<Layout title="ai.rhyslindmark.com" canonical="https://ai.rhyslindmark.com/">
	<div class="projects">
		{projects.map((project) => (
			<div class="project">
				<a href={project.url}>{project.url}</a>
				<a href={project.github}>GitHub</a>
			</div>
		))}
	</div>
</Layout>

<style>
	.projects {
		display: grid;
		gap: 2.5rem;
		padding: 2rem 0;
	}

	.project {
		display: grid;
		gap: 0.5rem;
	}

	a {
		width: fit-content;
		color: var(--text);
		font-family: var(--font-sans);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
