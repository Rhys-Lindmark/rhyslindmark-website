---
import Layout from '../../layouts/Layout.astro';

const projects = [
	{
		url: 'https://ai.rhyslindmark.com/givebetter',
		github: 'https://github.com/Rhys-Lindmark/market-for-impact',
	},
];

const roughDrafts = [
	{
		url: 'https://ai.rhyslindmark.com/domestication',
		github: 'https://github.com/Rhys-Lindmark/visualizing-reality',
	},
	{
		url: 'https://ai.rhyslindmark.com/music',
		github: 'https://github.com/Rhys-Lindmark',
	},
	{
		url: 'https://ai.rhyslindmark.com/byow',
		github: 'https://github.com/Rhys-Lindmark/byow',
	},
	{
		url: 'https://ai.rhyslindmark.com/games',
		github: 'https://github.com/Rhys-Lindmark/ai-games',
	},
	{
		url: 'https://ai.rhyslindmark.com/claims',
		github: 'https://github.com/Rhys-Lindmark/ai-claims',
	},
];
---

<Layout title="ai.rhyslindmark.com" canonical="https://ai.rhyslindmark.com/">
	<ul>
		{projects.map((project) => (
			<li>
				<a href={project.url}>{project.url}</a>{project.github && <>{' '}(<a href={project.github}>GitHub</a>)</>}
			</li>
		))}
	</ul>
	<h2>Rough drafts:</h2>
	<ul class="accelerator">
		{roughDrafts.map((project) => (
			<li>
				<a href={project.url}>{project.url}</a> (<a href={project.github}>GitHub</a>)
			</li>
		))}
	</ul>
</Layout>

<style>
	ul {
		margin: 0;
		padding: 2rem 0;
		padding-left: 1.25rem;
	}

	h2 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 1rem;
	}

	ul.accelerator {
		padding-top: 0.75rem;
	}

	li {
		margin-bottom: 0.5rem;
		font-family: var(--font-sans);
	}

	a {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
