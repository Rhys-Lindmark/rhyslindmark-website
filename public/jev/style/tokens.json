{
  "$description": "Jev design system tokens, v1 (2026-11-21). W3C Design Tokens format. Derived from typesafe.ai.",
  "color": {
    "$type": "color",
    "paper": { "$value": "#fefefe", "$description": "Page canvas, window bodies" },
    "ink": { "$value": "#1e1e1e", "$description": "Text, rules, title bars, filled buttons" },
    "ink-86": { "$value": "rgba(30, 30, 30, 0.86)", "$description": "Display type on rose" },
    "graphite": { "$value": "#3d3d3d", "$description": "Secondary headings" },
    "steel": { "$value": "#5e5e5e", "$description": "Helper text, captions" },
    "fog": { "$value": "#9a9a9a", "$description": "Disabled, placeholders" },
    "ash": { "$value": "#c4c4c4", "$description": "Inactive window panels" },
    "silver": { "$value": "#dedede", "$description": "Panels, quiet borders, table rules" },
    "mist": { "$value": "#f3f3f3", "$description": "Code wells, hover fills" },
    "rose": { "$value": "#f386a1", "$description": "The one brand colour: section fields and highlights, never body text" },
    "rose-soft": { "$value": "#fbe1e8", "$description": "Selected rows, soft highlight" },
    "signal": { "$value": "#03aa5c", "$description": "Pass, live and positive data only" },
    "signal-soft": { "$value": "#d9f2e6", "$description": "Background for signal states" },
    "alert": { "$value": "#c8102e", "$description": "Errors only" }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Inter Tight", "Die Grotesk C", "Helvetica Neue", "Arial", "sans-serif"] },
    "body": { "$value": ["Inter Tight", "Die Grotesk C", "Helvetica Neue", "Arial", "sans-serif"] },
    "mono": { "$value": ["JetBrains Mono", "LisaTerminal Paper", "ui-monospace", "Menlo", "monospace"] }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.display}", "fontSize": "64px", "fontWeight": 500, "lineHeight": 0.8, "letterSpacing": "-0.03em" } },
    "h1": { "$value": { "fontFamily": "{font.display}", "fontSize": "40px", "fontWeight": 500, "lineHeight": 0.9, "letterSpacing": "-0.03em" } },
    "h2": { "$value": { "fontFamily": "{font.display}", "fontSize": "24px", "fontWeight": 500, "lineHeight": 1, "letterSpacing": "-0.02em" } },
    "h3": { "$value": { "fontFamily": "{font.body}", "fontSize": "18px", "fontWeight": 500, "lineHeight": 1.1, "letterSpacing": "0" } },
    "body": { "$value": { "fontFamily": "{font.body}", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "0.01em" } },
    "small": { "$value": { "fontFamily": "{font.body}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0.01em" } },
    "label": { "$value": { "fontFamily": "{font.mono}", "fontSize": "12px", "fontWeight": 500, "lineHeight": 1, "letterSpacing": "0.02em" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "24px" }, "6": { "$value": "32px" }, "7": { "$value": "48px" }, "8": { "$value": "64px" },
    "max-width": { "$value": "1200px" }
  },
  "radius": { "$type": "dimension", "all": { "$value": "0px", "$description": "Everything is square" } },
  "border": {
    "$type": "border",
    "rule": { "$value": { "color": "{color.ink}", "width": "1px", "style": "solid" } },
    "rule-quiet": { "$value": { "color": "{color.silver}", "width": "1px", "style": "solid" } }
  },
  "shadow": {
    "$type": "shadow",
    "window": { "$value": { "color": "{color.ink}", "offsetX": "3px", "offsetY": "3px", "blur": "0px", "spread": "0px" }, "$description": "Hard offset, no blur: the only elevation" }
  }
}
